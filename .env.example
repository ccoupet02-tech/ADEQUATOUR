# Base de l'application (Neon). Sans cette variable, une base SQLite locale temporaire est utilisée.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require
APP_PASSWORD=choisir-un-mot-de-passe-long

# --- Ancien pipeline Notion (facultatif, conservé pour la reprise des données) ---
# ---- Notion (obligatoire) -------------------------------------------------
# Créer une intégration sur https://www.notion.so/profile/integrations puis,
# dans Notion, menu "..." > "Connexions" > ajouter l'intégration sur les 3 bases
# ci-dessous ET sur la page de chaque événement (les sous-pages héritent des droits).
NOTION_TOKEN=secret_xxx
# Identifiants des BASES (pas des vues). Valeurs de votre espace actuel :
NOTION_EVENTS_DB=389476d8-3937-8089-aa8f-f9574a596b40
NOTION_TASKS_DB=38a476d8-3937-80cb-bb13-ec2aa5997e63
NOTION_PARTICIPANTS_DB=bdafdb50-3570-4211-96a6-50d7adae5129
# Version d'API (2022-06-28 = bases à source de données unique, le cas ici)
NOTION_VERSION=2022-06-28

# ---- Typeform (pour sync-participants) --------------------------------------
TYPEFORM_TOKEN=tfp_xxx
# Compte hébergé en Europe ? alors : https://api.eu.typeform.com
TYPEFORM_API_BASE=https://api.typeform.com

# ---- Mails : dry-run (défaut, écrit des .eml), smtp ou graph -------------------
MAIL_BACKEND=dry-run
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Microsoft Graph (application avec permission Mail.Send + consentement admin)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# ---- Notifications (digest quotidien) -----------------------------------------
# Webhook entrant Slack / Teams (JSON {"text": "..."}), optionnel
NOTIFY_WEBHOOK_URL=
# Destinataires du digest par mail (séparés par des virgules), optionnel
DIGEST_RECIPIENTS=
